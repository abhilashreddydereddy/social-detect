{
  "manifest_version": 3,
  "name": "Social Detect — AI Media Authenticity Checker",
  "short_name": "Social Detect",
  "version": "0.2.3",
  "description": "Estimates whether images and videos on social media are AI-generated or manipulated. Returns a probability, a confidence score, and explainable evidence — never a definitive verdict.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "*://*.youtube.com/*",
    "*://youtube.com/*",
    "*://youtu.be/*",
    "*://*.instagram.com/*",
    "*://instagram.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://instagram.com/*"
      ],
      "js": ["content_scripts/core.js", "content_scripts/platforms/instagram.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*",
        "*://youtu.be/*"
      ],
      "js": ["content_scripts/core.js", "content_scripts/platforms/youtube.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
