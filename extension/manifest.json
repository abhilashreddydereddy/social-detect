{
  "manifest_version": 3,
  "name": "Social Detect — AI Media Authenticity Checker",
  "short_name": "Social Detect",
  "version": "0.1.0",
  "description": "Estimates whether images and videos on social media are AI-generated or manipulated. Returns a probability, a confidence score, and explainable evidence — never a definitive verdict.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*", "https://instagram.com/*"],
      "js": ["content_scripts/core.js", "content_scripts/platforms/instagram.js"],
      "run_at": "document_idle"
    }
  ]
}
